<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Package visibility (Play-friendly, replaces QUERY_ALL_PACKAGES): the picker only lists
         launchable apps, and the web filter needs to know which apps are browsers. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- findBrowserPackages queries http as well as https: a browser only has to be found
             once, and a filter declared for only one of the two schemes would otherwise be a
             browser with no filtering at all. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <!-- The keyword filter must know the home-screen apps so it never blocks the launcher. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Allowlist mode must never block the phone app. Without this declared, the
             ACTION_DIAL lookup in findEssentialPackages() is filtered to null on Android 11+
             and the dialer silently never makes it into the essentials. -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
        </intent>
        <!-- Lets the app resolve WHICH package would show the "uninstall this app?" dialog on
             this phone, for Profile ▸ What the blocker sees. Strict Mode's uninstall guard only
             fires on the installers named in GuardPackages, and those are vendor strings we
             cannot verify without owning each phone — this query turns that guess into something
             the screen can state as a fact, on whatever phone it is running on. -->
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
        <!-- The OEM keep-alive pages DeviceVendor deep-links to.
             **Package visibility filters an explicit component the same way it filters a query.**
             Without these declared, `startActivity` on com.miui.securitycenter/... throws
             ActivityNotFoundException on Android 11+ and openAutostart falls through to the
             app-details page — so the button silently never went where its own label said, on
             every phone, including the MIUI one that predates the other brands. Exactly the trap
             the ACTION_DIAL comment above describes, one file over.
             Named packages rather than QUERY_ALL_PACKAGES: see the note at the top of this
             block — the Play flavour must not regress on that. -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oplus.battery" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
    </queries>

    <!-- Lets the block screen appear over the blocked app. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Lets us measure how long an app is used (for daily limits). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Lets us ask to be exempt from battery optimization so blocking keeps running. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- AI Coach + (github flavor) updater. The updater-install and Wi-Fi/Location-schedule
         permissions live in src/github/AndroidManifest.xml — the Play flavor must not carry
         them (self-updating and background location are Play-review problems). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets us alert the user if the blocking service gets silently disabled. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Lets the app replace ITSELF with a newer version without the installer screen (API 31+).
         Only ever granted for a self-update by the app that installed the previous version, and
         only with a matching signature — see SilentInstaller. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppBlocker">
        <!-- The launcher entry lives on exactly ONE of the icon aliases below (Profile ▸ App icon
             switches them via PackageManager). MainActivity itself stays enabled so explicit
             intents (notification deep-links, updater) keep working regardless of chosen icon. -->
        <!-- adjustResize: the keyboard must never PAN the window (HyperOS's fallback without
             this) — panning shoves the top bar off-screen and fights the Compose inset
             layouts (safeDrawingPadding) every text-entry screen relies on. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".alias.IconHalo"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.IconViolet"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_violet"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.IconBlack"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_black"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.IconLight"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_light"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.IconSolid"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_solid"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".alias.IconLock"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_lock"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- The full-screen "Blocked" page. -->
        <activity
            android:name=".ui.BlockScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />

        <!-- Device admin: makes the app resist uninstall while enabled. -->
        <receiver
            android:name=".admin.AppBlockerAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Auto-blocks newly installed apps when that option is on. -->
        <receiver
            android:name=".service.PackageInstallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Hears the outcome of a silent self-update. Not exported: the only sender is the
             system, answering a PendingIntent we handed it ourselves. -->
        <receiver
            android:name=".service.InstallResultReceiver"
            android:exported="false" />

        <!-- Re-arms the protection watchdog after a reboot, and arms the after-update
             blocking pause the moment the app is updated. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Optional: counts daily notifications for the Insights "Distractions" card.
             Only active while the user grants Notification access. -->
        <service
            android:name=".service.NotificationCountListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: toggle Quick Block from the pull-down shade. -->
        <service
            android:name=".service.QuickBlockTileService"
            android:exported="true"
            android:icon="@drawable/ic_shield_white"
            android:label="Quick Block"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The watcher: detects the foreground app and blocks it. -->
        <service
            android:name=".service.BlockerAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
