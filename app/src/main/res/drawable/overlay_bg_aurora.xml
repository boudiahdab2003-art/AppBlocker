<?xml version="1.0" encoding="utf-8"?>
<!-- "Aurora" block-screen backdrop: the app's blue→violet accent gradient across the whole
     screen, running top-left to bottom-right so the violet lands behind the Got it button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#2E7BFF"
        android:endColor="#7C5CFF" />
</shape>
