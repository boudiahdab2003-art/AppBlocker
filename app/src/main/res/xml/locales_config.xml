<?xml version="1.0" encoding="utf-8"?>
<!--
  The languages the app is translated into, for Android 13+'s own per-app language screen.
  data/AppLocale.kt keeps that setting and the in-app picker in step; this file is what makes the
  system one exist at all.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
