<?xml version="1.0" encoding="utf-8"?>
<!-- "Focus" block screen: the app you tried to open, large and centred. No minutes counter —
     no score to admire, just the fact and the way out.
     The quote is here but kept deliberately small and centred, well under Editorial's 38sp
     (see quoteScale in BlockLayouts): this layout is the quiet one, and a hero-sized quote
     under a 96dp icon and a 32sp app name is both off-brief and the thing most likely to push
     "Got it" off a short screen. Switch it off in Pieces to get the original bare Focus back.
     Same view ids as overlay_block.xml so BlockOverlay fills any layout the same way; the ids
     a layout omits are simply absent and looked up null-safely.

     That warning above turned out to be exactly right, and it was measured rather than avoided:
     BlockScreenMatrixTest found this layout putting the button 12px below a TALL screen with
     every piece at "Huge" — which is the owner's own phone, near enough. The pieces now live in
     a scroller and the button is pinned outside it, so nothing above can displace it. See the
     long note in overlay_block.xml for why, and ui/FrictionGate.kt for where the rule came
     from. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="32dp"
        android:paddingTop="96dp"
        android:paddingBottom="36dp">

        <ScrollView
            android:id="@+id/overlay_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <LinearLayout
                    android:id="@+id/el_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <ImageView
                        android:id="@+id/overlay_icon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/overlay_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center"
                        android:fontFamily="serif"
                        android:textColor="@color/block_text_primary"
                        android:textSize="32sp"
                        android:lineSpacingMultiplier="1.1" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/el_kicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/overlay_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.18"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/block_text_secondary"
                        android:textSize="13sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/el_quote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/overlay_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center"
                        android:fontFamily="serif"
                        android:textColor="@color/block_text_primary"
                        android:textSize="22sp"
                        android:lineSpacingMultiplier="1.15" />

                    <TextView
                        android:id="@+id/overlay_quote_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.12"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/block_accent"
                        android:textSize="12sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/overlay_close"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/overlay_btn"
            android:text="Got it"
            android:textAllCaps="false"
            android:textColor="@color/block_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</FrameLayout>
