<?xml version="1.0" encoding="utf-8"?>
<!-- "Quote" block screen: the line is the whole screen, with the app that prompted it reduced
     to a small row at the top. No minutes counter — motivation instead of scorekeeping. Same
     view ids as overlay_block.xml (see the note there); the stat ids are simply absent.

     This is the only one of the four that BlockScreenMatrixTest did not catch overflowing, and
     it gets the same structure anyway: it has the largest quote of any layout (42sp before the
     size steps multiply it), so it was one longer quote away from the same defect. The fix is
     structural, so it belongs on all four rather than on the three that happened to fail — see
     the note in overlay_block.xml. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/overlay_bg"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingTop="72dp"
        android:paddingBottom="36dp">

        <ScrollView
            android:id="@+id/overlay_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/el_app"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/overlay_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/overlay_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/block_text_primary"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/overlay_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:letterSpacing="0.16"
                            android:fontFamily="sans-serif-black"
                            android:textColor="@color/block_text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/el_quote"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/overlay_quote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="serif"
                        android:textColor="@color/block_text_primary"
                        android:textSize="42sp"
                        android:lineSpacingMultiplier="1.14" />

                    <TextView
                        android:id="@+id/overlay_quote_author"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/block_accent"
                        android:textSize="17sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/overlay_close"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/overlay_btn"
            android:text="Got it"
            android:textAllCaps="false"
            android:textColor="@color/block_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />
    </LinearLayout>
</FrameLayout>
